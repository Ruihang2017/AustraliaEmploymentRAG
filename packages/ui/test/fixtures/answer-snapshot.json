  "jurisdictions": ["AU-CTH", "AU-VIC"],
  "short_answer": "A casual employee who has worked a regular pattern for twelve months may request conversion to permanent employment, subject to the employer's reasonable grounds for refusal.",
  "limitations": [
    "This answer covers the national system only and does not consider a state industrial instrument."
  ],
  "next_checks": [
    "Confirm whether an enterprise agreement covering the employee alters the conversion process."
  ],
  "assumptions": [
    {
      "id": "asm_0192f8c1-6a3f-7c21-9c8e-000000000010",
      "text": "The employee is a national system employee.",
      "impact_if_false": "State industrial law would apply instead and the conversion pathway would differ.",
      "source": "STATED_BY_USER"
    }
  ],
  "claims": [
    {
      "id": "clm_0192f8c1-6a3f-7c21-9c8e-000000000020",
      "sequence": 1,
      "kind": "RULE",
      "text": "A casual employee may request conversion after twelve months of employment.",
      "support_status": "DIRECTLY_SUPPORTED",
      "citation_ids": [
        "cit_0192f8c1-6a3f-7c21-9c8e-000000000030",
        "cit_0192f8c1-6a3f-7c21-9c8e-000000000031"
      ],
      "assumption_ids": ["asm_0192f8c1-6a3f-7c21-9c8e-000000000010"]
    },
    {
      "id": "clm_0192f8c1-6a3f-7c21-9c8e-000000000021",
      "sequence": 2,
      "kind": "QUALIFICATION",
      "text": "The employer may refuse the request on reasonable grounds.",
      "support_status": "CONDITIONAL",
      "citation_ids": ["cit_0192f8c1-6a3f-7c21-9c8e-000000000032"],
      "assumption_ids": []
    },
    {
      "id": "clm_0192f8c1-6a3f-7c21-9c8e-000000000022",
      "sequence": 3,
      "kind": "CAVEAT",
      "text": "An earlier decision reached the opposite conclusion on similar facts.",
      "support_status": "CONTRADICTED",
      "citation_ids": ["cit_0192f8c1-6a3f-7c21-9c8e-000000000033"],
      "assumption_ids": []
    }
  ],
