      "derived": true,
      "basis": "Sub-PRD D23(a) for the CRUD half and D23(b) for the appended verb: a named verb becomes POST /v1/<collection>/{id}/<verb>.",
      "operations": [
        { "method": "POST", "path": "/v1/comments" },
        { "method": "GET", "path": "/v1/comments" },
        { "method": "GET", "path": "/v1/comments/{comment_id}" },
