    {
      "prd_section": "16.2",
      "group": "Research and collaboration",
      "prd_line": "CRUD `/v1/research-records`",
      "derived": true,
      "basis": "Sub-PRD D23(a): CRUD = POST collection, GET collection, GET item, PATCH item, DELETE item. PATCH not PUT, because 34.1's If-Match row and 34.7's \"Mutable metadata updates require If-Match\" describe a partial metadata update. The item parameter is {id} to match the three sub-paths 16.2 spells below.",
      "operations": [
        { "method": "POST", "path": "/v1/research-records" },
        { "method": "GET", "path": "/v1/research-records" },
        { "method": "GET", "path": "/v1/research-records/{id}" },
        { "method": "PATCH", "path": "/v1/research-records/{id}" },
        { "method": "DELETE", "path": "/v1/research-records/{id}" }
      ]
    },
    {
      "prd_section": "16.2",
      "group": "Research and collaboration",
      "prd_line": "`/v1/research-records/{id}/turns`",
      "derived": true,
      "basis": "The path is verbatim; 16.2 states no methods. PRD 34.7 makes turns immutable — \"A mistake is corrected by adding a new turn with supersedes_turn_id, never by editing the original turn\" — so the surface is append and read only: no PATCH, no DELETE.",
      "operations": [
        { "method": "GET", "path": "/v1/research-records/{id}/turns" },
        { "method": "POST", "path": "/v1/research-records/{id}/turns" }
      ]
    },
    {
      "prd_section": "16.2",
      "group": "Research and collaboration",
      "prd_line": "`/v1/research-records/{id}/answers`",
      "derived": true,
      "basis": "The path is verbatim; 16.2 states no methods. Answer Snapshots are created through POST /v1/answers, not here, so this sub-resource is read-only.",
      "operations": [{ "method": "GET", "path": "/v1/research-records/{id}/answers" }]
    },
    {
      "prd_section": "16.2",
      "group": "Research and collaboration",
      "prd_line": "`/v1/research-records/{id}/review-actions`",
      "derived": true,
      "basis": "The path is verbatim; 16.2 states no methods. A review action is an appended record that moves the RecordWorkflowState (PRD 8.7), so list and create.",
      "operations": [
        { "method": "GET", "path": "/v1/research-records/{id}/review-actions" },
        { "method": "POST", "path": "/v1/research-records/{id}/review-actions" }
      ]
    },
