{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": true,
    "paths": {
      "@taxrag/web": ["./apps/web/src/index.ts"],
      "@taxrag/api": ["./apps/api/src/index.ts"],
      "@taxrag/worker": ["./apps/worker/src/index.ts"],
      "@taxrag/admin": ["./apps/admin/src/index.ts"],
      "@taxrag/widget": ["./apps/widget/src/index.ts"],
      "@taxrag/contracts": ["./packages/contracts/src/index.ts"],
      "@taxrag/domain": ["./packages/domain/src/index.ts"],
      "@taxrag/database": ["./packages/database/src/index.ts"],
      "@taxrag/auth": ["./packages/auth/src/index.ts"],
      "@taxrag/retrieval-client": ["./packages/retrieval-client/src/index.ts"],
      "@taxrag/model-gateway": ["./packages/model-gateway/src/index.ts"],
      "@taxrag/pii": ["./packages/pii/src/index.ts"],
      "@taxrag/citations": ["./packages/citations/src/index.ts"],
      "@taxrag/jobs": ["./packages/jobs/src/index.ts"],
      "@taxrag/observability": ["./packages/observability/src/index.ts"],
      "@taxrag/ui": ["./packages/ui/src/index.ts"],
      "@taxrag/sdk-typescript": ["./packages/sdk-typescript/src/index.ts"],
      "@taxrag/tests-integration": ["./tests/integration/src/index.ts"],
      "@taxrag/tests-tenant-isolation": ["./tests/tenant-isolation/src/index.ts"],
      "@taxrag/tests-security": ["./tests/security/src/index.ts"],
      "@taxrag/tests-e2e": ["./tests/e2e/src/index.ts"]
    }
  }
}
