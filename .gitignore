# agent-templates: ephemeral pipeline scratch
.claude/tmp/
.claude/allow-main-writes
docs/plans/*.md

# FND-01: build artifacts of the three workspaces. Lockfiles are committed; installed trees are not.
node_modules/
target/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# agent-templates: harness worktrees (concurrency > 1) — never commit, never scan
.claude/worktrees/

# agent-templates: never commit tokens (ASANA_TOKEN etc.)
.env
.env.local

# agent-templates: ephemeral Codex pipeline scratch
.codex/tmp/
.codex/allow-main-writes
docs/plans/*.md

# agent-templates: Codex worktrees — never commit, never scan
.codex/worktrees/

# agent-templates: root-level harness worktrees — never commit, never scan
# (untracked here, deliver-ticket.mjs sees a dirty tree and blocks every merge)
.worktrees/
